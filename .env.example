# ─────────────────────────────────────────────
# Provider 선택 (anthropic | openai)
# API 키가 하나만 있으면 자동 감지되므로 생략 가능
# ─────────────────────────────────────────────
MOTO_LLM_PROVIDER=anthropic

# ─────────────────────────────────────────────
# Anthropic (Claude)
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# 사용할 모델 (기본값: claude-sonnet-4-20250514)
MOTO_LLM_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# 최대 출력 토큰 수
# Claude는 출력 전체를 카운팅하므로 512 이상 권장 (기본값: 512)
MOTO_LLM_ANTHROPIC_MAX_OUTPUT_TOKENS=512

# ─────────────────────────────────────────────
# OpenAI (GPT)
# ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# 사용할 모델 (기본값: gpt-5-mini)
MOTO_LLM_OPENAI_MODEL=gpt-5-mini

# 최대 출력 토큰 수
# o-series reasoning 모델은 추론 토큰과 별도로 최종 텍스트만 카운팅하므로 60으로 충분 (기본값: 60)
MOTO_LLM_OPENAI_MAX_OUTPUT_TOKENS=60

# reasoning effort: minimal | medium | high (기본값: minimal)
MOTO_LLM_OPENAI_REASONING_EFFORT=minimal

# ─────────────────────────────────────────────
# 동작 설정
# ─────────────────────────────────────────────

# moto native 응답 검증 활성화 여부 (0 | 1, 기본값: 1)
MOTO_LLM_VALIDATE_NATIVE=1

# LLM 호출 최대 재시도 횟수 (기본값: 2)
# 줄이면 응답이 빨라지지만 응답 품질이 낮아질 수 있음
MOTO_LLM_AGENT_MAX_ATTEMPTS=2

# 오프라인 스텁 모드 — LLM 없이 기본값 응답만 반환 (1 | true, 기본값: 비활성)
# MOTO_LLM_OFFLINE_STUB=1

# ─────────────────────────────────────────────
# 허니팟 산출물 격리
# ─────────────────────────────────────────────

# start_server.sh 기준 데이터 루트입니다.
# 미지정 시 저장소 밖 /tmp/phantomgate 아래에 실행 로그와 보고서를 둡니다.
# MOTO_HONEYPOT_DATA_ROOT=/tmp/phantomgate

# 보고서 저장 경로를 직접 지정하고 싶을 때만 사용합니다.
# 미지정 시 start_server.sh가 ${MOTO_HONEYPOT_DATA_ROOT}/runs/{run_id}/reports 로 설정합니다.
# MOTO_HONEYPOT_REPORT_DIR=/tmp/phantomgate/reports

# 서버가 사용할 Python/venv를 직접 지정할 수 있습니다.
# MOTO_SERVER_PYTHON=/tmp/phantomgate/venv/bin/python

# ─────────────────────────────────────────────
# 고급 설정
# ─────────────────────────────────────────────

# 감사 로그 파일 경로 (설정 시 모든 요청/응답을 JSON으로 기록)
# MOTO_LLM_AUDIT_FILE=/var/log/honeypot_audit.json

# .env 파일 경로 명시적 지정 (기본값: 현재 디렉토리 및 상위 디렉토리에서 자동 탐색)
# MOTO_LLM_ENV_FILE=/path/to/.env

# Anthropic API 버전 (기본값: 2023-06-01)
# MOTO_LLM_ANTHROPIC_VERSION=2023-06-01
